# Bot token from https://discord.com/developers/applications → Bot → Reset Token / Copy
DISCORD_TOKEN=

# Set to 1 only after enabling "Server Members Intent" in the Developer Portal (Bot → Privileged Gateway Intents).
# If this is 1 without that toggle, Discord will disconnect the Gateway (4014) and the bot will never show online.
ENABLE_MEMBER_EVENTS=

# Optional: channel id where the bot posts a short "what I do" message once per process start (must match a channel the bot can access).
BOT_INFO_CHANNEL_ID=

# Optional: profile activity and status. Leave all three empty to skip setting presence.
# Activity type: 0=Playing, 2=Listening, 3=Watching, 5=Competing, etc. See Discord docs.
BOT_ACTIVITY_NAME=
BOT_ACTIVITY_TYPE=
# online | idle | dnd | invisible
BOT_PRESENCE_STATUS=
